---
import type { Commit } from "../lib/data";
import { short, vendorOnly, TYPE_LABEL } from "../lib/data";
import { inline } from "../lib/render";

interface Props { commit: Commit; tag: string; }
const { commit: c, tag } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = `${base}ufs/${tag}/${short(c.sha)}/`;
---
<div
  class="row"
  data-row
  data-area={c.area}
  data-type={c.change_type ?? ""}
  data-importance={c.importance ?? ""}
  data-vendors={vendorOnly(c).join(" ")}
>
  <div class="top">
    {c.importance && <span class={`badge ${c.importance}`}>{c.importance}</span>}
    {c.change_type && <span class="badge plain">{TYPE_LABEL[c.change_type]}</span>}
    {c.cc_stable && <span class="badge accent">stable</span>}
    {c.fixes.length > 0 && <span class="badge plain">Fixes {c.fixes[0].introduced_in ?? ""}</span>}
  </div>
  <p class="summary" set:html={inline(c.summary_ko) || c.subject} />
  <a class="subject" href={href}>{short(c.sha)} {c.subject}</a>
</div>
