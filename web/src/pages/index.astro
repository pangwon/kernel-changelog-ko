---
import Base from "../layouts/Base.astro";
import { releases, formatDate, AREA_ORDER } from "../lib/data";
import { inline } from "../lib/render";

const base = import.meta.env.BASE_URL;
const list = releases();
const total = list.reduce((n, r) => n + r.commit_count, 0);
---
<Base title="kernel-changelog-ko · UFS 릴리스별 변경 요약" description="리눅스 커널 메인라인 UFS 서브시스템 변경사항을 릴리스별로 한국어로 요약합니다.">
  <h1>UFS 서브시스템 변경 요약</h1>
  <p class="headline">
    리눅스 커널 메인라인의 UFS 변경을 릴리스별로 한국어로 요약했습니다.
    {list[list.length - 1].tag}부터 {list[0].tag}까지 {list.length}개 릴리스, 커밋 {total}개.
  </p>
  <div class="cards release-list">
    {list.map((r) => (
      <a class="card" href={`${base}ufs/${r.tag}/`} style="color: inherit; text-decoration: none;">
        <h2>{r.tag}</h2>
        <div class="meta-line">
          <span>{formatDate(r.date)}</span>
          <span>{r.prev_tag}..{r.tag}</span>
          <span>커밋 {r.commit_count}</span>
          <span>시리즈 {r.series_count}</span>
        </div>
        <p set:html={inline(r.highlights_ko?.headline_ko) || "요약 준비 중"} />
        <div class="areas-mini">
          {AREA_ORDER.filter((a) => r.areas[a]).map((a) => (
            <span class="badge plain">{a} {r.areas[a]}</span>
          ))}
        </div>
      </a>
    ))}
  </div>
</Base>
